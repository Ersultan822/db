/* =====================================================
   1. ✅ 1NF (атомарлық мәндер)
===================================================== */

CREATE TABLE articles_1nf (
    article_id SERIAL PRIMARY KEY,
    title VARCHAR(200)
);

CREATE TABLE tags_1nf (
    tag_id SERIAL PRIMARY KEY,
    tag_name VARCHAR(50)
);

CREATE TABLE article_tag_1nf (
    article_id INT,
    tag_id INT
);

