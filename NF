/* =====================================================
   2. ❌ 2NF БҰЗЫЛҒАН (partial dependency)
===================================================== */

CREATE TABLE nf2_bad (
    article_id INT,
    title VARCHAR(200),
    category_name VARCHAR(100)
);

INSERT INTO nf2_bad
VALUES
(1,'Жаңа заң','Саясат'),
(2,'Футбол','Спорт');


/* =====================================================
   2. ✅ 2NF (category бөлек)
===================================================== */

CREATE TABLE categories_2nf (
    category_id SERIAL PRIMARY KEY,
    category_name VARCHAR(100)
);

CREATE TABLE articles_2nf (
    article_id SERIAL PRIMARY KEY,
    title VARCHAR(200),
    category_id INT REFERENCES categories_2nf(category_id)
);

INSERT INTO categories_2nf (category_name)
VALUES ('Саясат'),('Спорт');

INSERT INTO articles_2nf (title,category_id)
VALUES
('Жаңа заң',1),
('Футбол',2);


/* =====================================================
   3. ❌ 3NF БҰЗЫЛҒАН (transitive dependency)
===================================================== */

CREATE TABLE nf3_bad (
    user_id INT,
    username VARCHAR(50),
    role_name VARCHAR(20)
);

INSERT INTO nf3_bad
VALUES
(1,'admin','admin'),
(2,'aidar','journalist'),
(3,'reader1','reader');


/* =====================================================
   3. ✅ 3NF (артық тәуелділік жойылды)
===================================================== */

CREATE TABLE users_3nf (
    user_id SERIAL PRIMARY KEY,
    username VARCHAR(50),
    role VARCHAR(20) CHECK (role IN ('admin','journalist','reader'))
);

INSERT INTO users_3nf (username,role)
VALUES
('admin','admin'),
('aidar','journalist'),
('reader1','reader');


